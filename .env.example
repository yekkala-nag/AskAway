# AskAway environment variables
# Copy to .env.local (gitignored) for local development.
# Set these same values in the Vercel dashboard for production.

# ── Client-side (exposed to the browser via Vite) ──
# Only the Supabase URL and anon key may reach the client. Never put secrets here.
VITE_SUPABASE_URL=https://zmrplimcswbfhgkbslpx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Server-side (Vercel only — never in repo, never in client bundle) ──
SUPABASE_URL=https://zmrplimcswbfhgkbslpx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=your-openai-api-key
